# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/taskboard?retryWrites=true&w=majority
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
NODE_ENV=development
